{
  "schemaVersion": 1,
  "id": "turtlematic",
  "version": "${version}",
  "name": "Turtlematic",
  "description": "CC:T addon, that makes turtles great again!",
  "authors": [
    "SirEdvin"
  ],
  "contact": {
    "homepage": "https://docs.siredvin.site/Turtlematic/",
    "issues": "https://github.com/SirEdvin/Turtlematic/issues",
    "sources": "https://github.com/SirEdvin/Turtlematic"
  },
  "license": "MIT",
  "icon": "pack.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "site.siredvin.turtlematic.FabricTurtlematic"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "site.siredvin.turtlematic.FabricTurtlematicClient"
      }
    ],
    "fabric-datagen": [
      {
        "adapter": "kotlin",
        "value": "site.siredvin.turtlematic.data.FabricDataGenerators"
      }
    ]
  },
  "mixins": [
    "turtlematic.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric": "*",
    "fabric-language-kotlin": ">=1.11.0+kotlin.2.0.0",
    "minecraft": ">=1.21.1 <1.21.2",
    "java": ">=21 <22",
    "forgeconfigapiport": ">=21.1.6",
    "computercraft": ">=${computercraftVersion}",
    "broccolium": ">=${broccoliumVersion}",
    "tweakium": ">=${tweakiumVersion}",
    "peripheralium": ">=${peripheraliumVersion}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/dYHKMQYRPp"
      }
    }
  }
}
